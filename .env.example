# Control plane
PORT=3000
ADMIN_TOKEN=replace-with-at-least-16-random-characters
BROKER_TOKEN=replace-with-a-separate-broker-secret
DATA_DIR=/var/lib/redmi-control

# Minecraft / Crafty
MC_HOST=127.0.0.1
MC_PORT=25565
MC_LOG=/opt/crafty/crafty-4/servers/<server-id>/logs/latest.log
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD_FILE=/etc/redmi-control/rcon-password

# Network advertisement
# Prefer the Tailscale address when omitted.
PUBLIC_HOST=
TRUSTED_NETWORK_ONLY=1

# Root execution
# Keep legacy mode enabled until the Android RootBroker is validated on-device.
LEGACY_ROOT_EXECUTOR=1
ROOT_CONTROL_ENABLED=0
